VERIFIER_BASE_URL=http://127.0.0.1:8000/v1
VERIFIER_MODEL=google/diffusiongemma-26B-A4B-it
# Set an inbound key before exposing the gateway beyond loopback.
# VERIFIER_API_KEY=replace-with-a-random-secret
# Set if the vLLM server requires authentication (separate from the gateway key).
# VERIFIER_UPSTREAM_API_KEY=your-vllm-key
VERIFIER_MAX_CONCURRENCY=8
VERIFIER_MAX_REQUESTS=32
VERIFIER_REQUEST_TIMEOUT=60
VERIFIER_UPSTREAM_TIMEOUT=30
VERIFIER_VALIDATION_RETRIES=1
VERIFIER_MAX_OUTPUT_TOKENS=2048
VERIFIER_TEMPERATURE=0
